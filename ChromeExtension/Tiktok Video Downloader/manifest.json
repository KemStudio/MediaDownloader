{
  "manifest_version": 3,
  "name": "TikTok Video Downloader",
  "version": "1.0.0",
  "description": "Lưu link video TikTok hiện tại và tải video khi trang cung cấp URL trực tiếp.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.ibytedtos.com/*",
    "https://*.byteoversea.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "action": {
    "default_title": "TikTok Video Downloader"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*", "https://*.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon_download_den.png", "icon_download_trang.png"],
      "matches": ["https://www.tiktok.com/*", "https://*.tiktok.com/*"]
    }
  ]
}
